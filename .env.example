APP_NAME=STAR CYBER AI X
APP_ENV=production
STAR_API_TOKEN=change-this-long-random-secret

DATABASE_PATH=/data/starcyber.db
EVIDENCE_DIR=/data/evidence

# Recommended free AI brain
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3.8-27b

# Optional: switch to your own OpenAI-compatible server later
# AI_PROVIDER=self_hosted
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=local
LLM_MODEL=Qwen3-Coder
LLM_TIMEOUT=120

# Optional but required for private GitHub repositories
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

NUCLEI_RATE_LIMIT=10
