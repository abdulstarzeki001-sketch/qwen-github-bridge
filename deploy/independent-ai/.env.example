# LOCAL SERVER ONLY. Copy to .env and chmod 600 .env.
# Generate the backend token: openssl rand -hex 32
STAR_BACKEND_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
# Create a remotely-managed Cloudflare Tunnel and paste its TOKEN here.
CF_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN
STAR_MODEL=gpt-oss:20b
