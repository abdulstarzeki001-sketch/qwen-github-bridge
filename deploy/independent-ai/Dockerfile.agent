# Optional STAR coding-agent container: separate from production API and model host.
# Installing exactly the GitHub WormGPTv2 v0.22.0 release; no lifecycle scripts.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git bash \
 && rm -rf /var/lib/apt/lists/*
ARG WORMGPT_SHA256=4b4668f8e00a41fc7780c368a22dfc268dd9cf5aa74dd73230de96ed5093a0fd
RUN set -eu; \
    curl -fsSL --retry 2 --connect-timeout 15 \
      https://github.com/WormGPTv2/wormgpt/releases/download/v0.22.0/gitlawb-wormgpt-0.22.0.tgz \
      -o /tmp/wormgpt.tgz; \
    echo "$WORMGPT_SHA256  /tmp/wormgpt.tgz" | sha256sum -c -; \
    npm install -g --ignore-scripts --no-audit --no-fund /tmp/wormgpt.tgz; \
    rm -f /tmp/wormgpt.tgz
WORKDIR /workspace
USER node
ENTRYPOINT ["node","/usr/local/lib/node_modules/@gitlawb/wormgpt/dist/cli.mjs"]
CMD []
